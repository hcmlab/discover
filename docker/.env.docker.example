# DISCOVER Docker Configuration
# Copy this file to .env and customize for your setup

# DISCOVER Version from PyPI
# Set to "latest" for newest version or specify version like "1.1.0"
DISCOVER_VERSION=latest

# User/Group IDs for file permissions (rootless Docker compatibility)
# Find your IDs with: id -u (UID) and id -g (GID)
UID=1000
GID=1000

# Server Configuration
DISCOVER_USE_TLS=false

# Host port (what you'll connect to from your browser)
# DISCOVER always listens on 0.0.0.0:8080 inside the container
# Set this to your desired external port
HOST_PORT=8080

# Directory Paths (HOST machine paths for volume mounting)
# IMPORTANT: These are HOST paths for Docker volume mounts, NOT container paths
# docker-compose.yml automatically maps these to /app/* inside the container
#
# Use relative paths (../) since docker-compose.yml is in docker/ subfolder
# OR use absolute paths for network drives (e.g., /mnt/network/data)
#
# Examples:
#   Relative: ../cache, ../cml, ../data, ../log
#   Absolute: /mnt/datasets/nova/data, /home/user/discover-modules/modules
#
# Note: Inside the container, DISCOVER will use /app/cache, /app/cml, /app/data, /app/log, /app/tmp
HOST_CACHE_DIR=../cache
HOST_CML_DIR=../cml
HOST_DATA_DIR=../data
HOST_LOG_DIR=../log
HOST_TMP_DIR=../tmp

# Backend Configuration
DISCOVER_BACKEND=venv
DISCOVER_VIDEO_BACKEND=IMAGEIO

# Virtual Environment Options
VENV_FORCE_UPDATE=False
VENV_LOG_VERBOSE=True

# PyPI Index URLs (semicolon-separated)
# Example for PyTorch with CUDA 11.8:
# VENV_EXTRA_INDEX_URLS=https://download.pytorch.org/whl/cu118
VENV_EXTRA_INDEX_URLS=https://download.pytorch.org/whl/cu129;https://download.pytorch.org/whl/cu128;https://download.pytorch.org/whl/cu126;https://download.pytorch.org/whl/cu124;https://download.pytorch.org/whl/cu121

# TLS Configuration
# To enable TLS:
#   1. Set DISCOVER_USE_TLS=true above
#   2. Uncomment the certs volume mount in docker-compose.yml
#   3. Place your certs in HOST_CERTS_DIR (default: ../certs)
# Cert paths default to /app/certs/*.pem in docker-compose.yml
# Only override if using a different container path:
# DISCOVER_SSL_CERT=/app/certs/discover_cert.pem
# DISCOVER_SSL_KEY=/app/certs/discover_key.pem
# HOST_CERTS_DIR=../certs
